                    <outputColumn
                      refId="Package\Load Fact_Surgeries\Calculate Measures.Outputs[Derived Column Output].Columns[surgery_duration_minutes]"
                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Load Fact_Surgeries\Calculate Measures.Outputs[Derived Column Output].Columns[surgery_duration_minutes]"
                      name="surgery_duration_minutes"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)([DATEDIFF]("minute",(DT_DBTIMESTAMP)#{Package\Load Fact_Surgeries\SRC STG_SurgeryRecord.Outputs[OLE DB Source Output].Columns[start_Time]},(DT_DBTIMESTAMP)#{Package\Load Fact_Surgeries\SRC STG_SurgeryRecord.Outputs[OLE DB Source Output].Columns[end_Time]}) + ([DATEPART]("hh",(DT_DBTIMESTAMP)#{Package\Load Fact_Surgeries\SRC STG_SurgeryRecord.Outputs[OLE DB Source Output].Columns[end_Time]}) &lt; [DATEPART]("hh",(DT_DBTIMESTAMP)#{Package\Load Fact_Surgeries\SRC STG_SurgeryRecord.Outputs[OLE DB Source Output].Columns[start_Time]}) ? 1440 : 0))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_I4)(DATEDIFF("minute",(DT_DBTIMESTAMP)start_Time,(DT_DBTIMESTAMP)end_Time) + (DATEPART("hh",(DT_DBTIMESTAMP)end_Time) &lt; DATEPART("hh",(DT_DBTIMESTAMP)start_Time) ? 1440 : 0))</property>
                      </properties>
                    </outputColumn>
